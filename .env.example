# Copie para .env.local e preencha. Nunca commite valores reais.

# Supabase (Project Settings → API). O schema "barbearia" precisa estar em "Exposed schemas".
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-somente-servidor

# URL pública do app (usada em links de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo da rota /api/cron/emails (gere com: openssl rand -hex 32)
CRON_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Resend (opcional). Sem domínio verificado, só entrega para o e-mail dono da conta Resend.
RESEND_API_KEY=
EMAIL_FROM=Barbearia Demo <onboarding@resend.dev>
EMAIL_TEST_RECIPIENT=

# Sentry (opcional)
NEXT_PUBLIC_SENTRY_DSN=
